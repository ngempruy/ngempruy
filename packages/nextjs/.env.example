NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=

# ---- Module settings (generated by `yarn configure` from the module manifests) ----
# Testnet account id (0.0.x) that pays for HCS/HTS transactions
HEDERA_OPERATOR_ID=
# ECDSA private key (hex) of HEDERA_OPERATOR_ID; must be the audit topic's submit key (the deployer's key). Never commit it.
HEDERA_OPERATOR_KEY=
# Overrides the HCS audit topic that `yarn hardhat:deploy` records in hederaResources.json (optional)
NEXT_PUBLIC_AUDIT_TOPIC_ID=
# Hedera account id (0.0.x) that receives x402 payments
X402_PAY_TO=
# x402 facilitator (default Blocky402 testnet: https://api.testnet.blocky402.com) (optional)
X402_FACILITATOR_URL=
# Price per request in tinybars (default 1000000 = 0.01 HBAR) (optional)
X402_PRICE_TINYBARS=
