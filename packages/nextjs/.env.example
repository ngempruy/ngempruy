NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=

# --- Core module (server-side only, never prefix with NEXT_PUBLIC_) ---
# Testnet account id (0.0.x) that pays for HCS/HTS transactions
HEDERA_OPERATOR_ID=
# ECDSA private key (hex) of HEDERA_OPERATOR_ID. Never commit it.
HEDERA_OPERATOR_KEY=
# HCS topic id of the audit log (created by the setup script)
NEXT_PUBLIC_AUDIT_TOPIC_ID=

# --- Payments module (x402) ---
# Hedera account id (0.0.x) that receives x402 payments
X402_PAY_TO=
# x402 facilitator (default Blocky402 testnet: https://api.testnet.blocky402.com)
X402_FACILITATOR_URL=
# Price per request in tinybars (default 1000000 = 0.01 HBAR)
X402_PRICE_TINYBARS=
